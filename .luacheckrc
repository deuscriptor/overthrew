local luacheck = require("luacheck")
local lfs = require("lfs")

local globals, fields = {}, {table = {}, string = {}, math = {}}

for name in engine:gmatch("%S+") do
	globals[#globals + 1] = name
end

local function scan(dir)
	for entry in lfs.dir(dir) do
		local path = dir .. "/" .. entry
		if entry:sub(1, 1) ~= "." then
			if lfs.attributes(path, "mode") == "directory" then
				scan(path)
			elseif entry:match("%.lua$") then
				local file = assert(io.open(path, "rb"))
				local report = luacheck.get_report(file:read("*a"))
				file:close()
				for _, warning in ipairs(report.warnings) do
					local name, indexing = warning.name, warning.indexing
					if warning.code == "111" then
						globals[#globals + 1] = name
					elseif warning.code == "112" and #indexing == 1 then
						if name == "_G" then
							globals[#globals + 1] = indexing[1]
						elseif fields[name] then
							fields[name][indexing[1]] = {read_only = false}
						end
					end
				end
			end
		end
	end
end

scan("scripts/vscripts")

stds.overthrew = {
	globals = globals,
	read_globals = {
		table = {fields = fields.table},
		string = {fields = fields.string},
		math = {fields = fields.math},
	},
}
